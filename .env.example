# Copy to .env.local for `npm run dev`. Vite exposes only VITE_* names to the browser.
# Do not put a service-role or secret key in any of these.

# https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_...). Preferred.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT. Used only when VITE_SUPABASE_PUBLISHABLE_KEY is empty.
# VITE_SUPABASE_ANON_KEY=

# Optional override. Leave unset: Vercel (VERCEL=1) uses /, GitHub Pages uses /teachingapp/.
# VITE_BASE_PATH=/
