{
  "name": "teachingapp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && npm run check:sync && npm run check:error-log && vite build",
    "check:drills": "esbuild scripts/check-drills.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-drills.mjs && node node_modules/.cache/check-drills.mjs",
    "check:j18fig": "esbuild scripts/check-j18fig.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-j18fig.mjs && node node_modules/.cache/check-j18fig.mjs",
    "check:sync": "esbuild scripts/check-sync.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-sync.mjs && node node_modules/.cache/check-sync.mjs",
    "check:error-log": "esbuild scripts/check-error-log.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-error-log.mjs && node node_modules/.cache/check-error-log.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "katex": "^0.16.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
